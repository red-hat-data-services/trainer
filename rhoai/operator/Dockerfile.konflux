# Build the manager binary
# Build context is the repository root so the nested module can resolve its
# local replace of github.com/kubeflow/trainer/v2 (../../ from this directory).
FROM registry.access.redhat.com/ubi9/go-toolset@sha256:4053e919374d739ee6b0007e412d89256b0bd065e0bc690c2b3905bbaab6500e as builder

WORKDIR /workspace

# Copy the Go Modules manifests
COPY go.mod go.mod
COPY go.sum go.sum
COPY pkg/apis/ pkg/apis/
COPY rhoai/operator/go.mod rhoai/operator/go.mod
COPY rhoai/operator/go.sum rhoai/operator/go.sum

WORKDIR /workspace/rhoai/operator
# cache deps before building and copying source so that we don't need to re-download as much
# and so that source changes don't invalidate our downloaded layer
RUN go mod download

# Copy the go source
COPY rhoai/operator/ ./

# Build
USER root
RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime GOOS=linux go build -a -o manager cmd/main.go

# Runtime
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8@sha256:d638f3b49b79575329aacdae2739f954effe2467c12147711e73445c4fc97819

WORKDIR /
COPY --from=builder /workspace/rhoai/operator/manager .
COPY manifests/base/ /opt/manifests-template/base/
COPY manifests/rhoai/ /opt/manifests-template/rhoai/
COPY manifests/component_metadata.yaml /opt/manifests-template/
COPY rhoai/operator/manifests/runtimes/ /opt/runtimes-template/
COPY rhoai/operator/manifests/imagestreams/ /opt/imagestreams-template/
USER 65532:65532

ENTRYPOINT ["/manager"]

LABEL com.redhat.component="odh-trainer-operator-rhel9" \
      name="rhoai/odh-trainer-operator-rhel9" \
      description="odh-trainer-operator" \
      summary="odh-trainer-operator" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="" \
      io.k8s.display-name="odh-trainer-operator" \
      io.k8s.description="odh-trainer-operator" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"
