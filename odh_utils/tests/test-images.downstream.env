# Downstream-specific image repository -> environment variable mappings.
#
# The repositories built downstream of upstream (e.g. the RHOAI Konflux builds
# pushing to the private quay.io/rhoai, and the released images the upgrade
# test starts from) differ from the upstream quay.io/opendatahub ones mapped
# by test-images.env. This file maps them without touching the shared
# test-images.env, so syncing with upstream stays conflict-free.
#
# The downstream integration test pipelines point TEST_IMAGE_ENVS_FILE at this
# file; see deploy-trainer-operator in Makefile.rhai for how the mappings are
# consumed.
quay.io/rhoai/odh-trainer-rhel9=RELATED_IMAGE_ODH_TRAINER_IMAGE
quay.io/rhoai/odh-trainer-operator-rhel9=OPERATOR_IMAGE
quay.io/rhoai/odh-th-torch-cuda-py312-rhel9=RELATED_IMAGE_ODH_TH_TORCH_CUDA_PY312_IMAGE
quay.io/rhoai/odh-th-torch-rocm-py312-rhel9=RELATED_IMAGE_ODH_TH_TORCH_ROCM_PY312_IMAGE
quay.io/rhoai/odh-th-torch-cpu-py312-rhel9=RELATED_IMAGE_ODH_TH_TORCH_CPU_PY312_IMAGE
